# ===== API =====
PORT=3000

# ===== Banco de dados (Postgres) — usado também pelo docker-compose =====
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=postgres
DB_SYNCHRONIZE=false
DB_LOGGING=false

# ===== Redis (fila BullMQ) — usado também pelo docker-compose =====
REDIS_HOST=localhost
REDIS_PORT=6379

# ===== Autenticação (JWT) =====
JWT_SECRET=dev-secret-change-me
JWT_EXPIRES_IN=28800s

# ===== Admin inicial (seeds) =====
ADMIN_DEFAULT_EMAIL=admin@somar.local
ADMIN_DEFAULT_PASSWORD=admin123